{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "quote",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "clean": "rm -rf .output .nitro .tanstack",
    "check-types": "tsgo --noEmit",
    "build": "bun --bun vite build",
    "dev": "infisical run --projectId=4bc06c11-1fe4-44be-b7cc-00e9aad2986b --env=prod -- bun --bun vite dev --port 3001",
    "preview": "infisical run -- bun --bun vite preview",
    "start": "infisical run --projectId=4bc06c11-1fe4-44be-b7cc-00e9aad2986b --env=dev -- bun --bun vite start",
    "test": "bun test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check src vite.config.ts --max-warnings 0",
    "lint:fix": "oxlint --type-aware --type-check src vite.config.ts --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@repo/data": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tanstack/zod-adapter": "catalog:",
    "jose": "^6.2.10",
    "js-cookie": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "resend": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@tanstack/devtools-vite": "catalog:",
    "@types/bun": "^1.4.0",
    "@types/js-cookie": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "^7.0.1-rc",
    "vite": "catalog:"
  }
}
