{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./quotes": "./src/quotes.ts"
  },
  "scripts": {
    "check-types": "tsgo --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check src --max-warnings 0",
    "lint:fix": "oxlint --type-aware --type-check src --fix"
  },
  "dependencies": {},
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
