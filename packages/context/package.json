{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@repo/context",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./disclosure": "./src/disclosure.ts",
		"./session": "./src/session.ts"
	},
	"scripts": {
		"check-types": "tsgo --noEmit",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --type-aware --type-check src --max-warnings 0",
		"lint:fix": "oxlint --type-aware --type-check src --fix"
	},
	"dependencies": {
		"react": "catalog:",
		"react-dom": "catalog:",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@repo/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	}
}
